generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Roles and statuses are plain strings constrained by the unions in
// src/lib/server/cases.ts and src/lib/server/auth.ts.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String
  createdAt    DateTime @default(now())

  uploadedCases Case[] @relation("UploadedBy")
}

// Pseudonymous patient reference only — no real names/identifiers, per the
// "no real patient identifiers" compliance requirement.
model Patient {
  id           String   @id @default(uuid())
  pseudonymRef String   @unique
  createdAt    DateTime @default(now())

  cases Case[]
}

// Status transitions: DRAFT -> AWAITING_REVIEW -> (REJECTED_QC | UNDER_REVIEW)
// -> VERIFIED -> DIAGNOSED -> RELEASED. RELEASED is immutable; every
// transition is written to AuditLog by the API layer, never skipped.
model Case {
  id           String   @id @default(uuid())
  status       String   @default("DRAFT")
  organ        String
  patientId    String
  uploadedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patient    Patient  @relation(fields: [patientId], references: [id])
  uploadedBy User     @relation("UploadedBy", fields: [uploadedById], references: [id])
  images     CaseImage[]
  prediction AiPrediction?
  review     Review?
  diagnosis  Diagnosis?
}

model CaseImage {
  id           String   @id @default(uuid())
  caseId       String
  storedName   String   @unique // UUID filename — never the original filename
  originalMime String
  data         Bytes    // image bytes live in the database, so they persist
  createdAt    DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id])
}

model AiPrediction {
  id           String   @id @default(uuid())
  caseId       String   @unique
  modelVersion String   // pinned per-case forever, e.g. "1.0.0"
  organ        String
  label        String   // BENIGN | MALIGNANT
  probability  Float
  logitsJson   String
  createdAt    DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id])
}

// Pathologist's own read, recorded before the AI prediction is revealed
// (blind-read-then-reveal).
model Review {
  id         String   @id @default(uuid())
  caseId     String   @unique
  reviewerId String
  blindLabel String
  finalLabel String
  notes      String?
  createdAt  DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id])
}

model Diagnosis {
  id          String    @id @default(uuid())
  caseId      String    @unique
  clinicianId String
  summary     String
  releasedAt  DateTime?
  createdAt   DateTime  @default(now())

  case Case @relation(fields: [caseId], references: [id])
}

// Append-only — no update/delete anywhere in the API for this model.
model AuditLog {
  id        String   @id @default(uuid())
  caseId    String?
  userId    String?
  action    String
  detail    String?
  createdAt DateTime @default(now())
}
